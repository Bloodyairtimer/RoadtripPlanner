{
  "Data": {
    "Directory": "data"
  },
  "Maps": {
    "NominatimUrl": "https://nominatim.openstreetmap.org/",
    "OverpassUrl": "https://overpass-api.de/api/interpreter",
    "OverpassFallbackUrls": [
      "https://overpass.private.coffee/api/interpreter"
    ],
    "RoutingUrl": "https://router.project-osrm.org/",
    "UserAgent": "RoadtripPlanner/1.0 (+https://github.com/Bloodyairtimer/RoadtripPlanner)"
  },
  "Park4Night": {
    "Enabled": true,
    "SearchUrl": "https://guest.park4night.com/services/V4.1/lieuxGetFilter.php"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TomTom": {
    "MonthlyRequestLimit": 1000
  }
}
